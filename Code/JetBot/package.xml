<?xml version="1.0"?>
<package format="2">
  <name>jetbot_vslam</name>
  <version>1.1.0</version>
  <description>
    Monocular vSLAM (ORB-SLAM2) with encoder fusion, world-aligned occupancy
    grid mapping, and multi-mode collision avoidance for the SparkFun JetBot
    v2.1-based mobile robot on the NVIDIA Jetson Nano Developer Kit A02.
  </description>

  <maintainer email="srikanth.nanda@example.com">Srikanth Nanda</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Build/run dependencies -->
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf</depend>

  <!-- Runtime-only dependencies -->
  <exec_depend>map_server</exec_depend>
  <exec_depend>orb_slam2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
  </export>
</package>
